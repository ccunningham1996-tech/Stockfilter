# Credentials template for the QUAL-style quality factor screen.
# Copy to .env.quality and fill in keys from a SEPARATE Alpaca paper account
# (create one specifically for this strategy so its equity curve stays
# isolated from the momentum screener's account).

FINNHUB_API_KEY=your_finnhub_api_key_here
ALPACA_API_KEY=your_quality_account_alpaca_api_key_here
ALPACA_SECRET_KEY=your_quality_account_alpaca_secret_key_here

# Keeps this strategy's signals/holdings in their own DB file, isolated
# from data/screener.db (the momentum screener) and data/value.db.
SCREENER_DB_PATH=data/quality.db
