# Credentials for NDX Momentum Buffered.
# Copy to .env.ndx_mom_buffer and fill in keys from a NEW, SEPARATE Alpaca
# paper account created only for this strategy. It must not share an account
# with Momentum, Value or Quality -- the strategy checks this and refuses to
# run if it does.

ALPACA_API_KEY=your_ndx_mom_buffer_paper_api_key_here
ALPACA_SECRET_KEY=your_ndx_mom_buffer_paper_secret_key_here

# Paper only. The strategy hard-codes this endpoint and refuses to run if this
# (or ALPACA_BASE_URL / APCA_API_BASE_URL in the environment) is anything else.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Where this strategy's history lives; read by scripts/compare_vs_spy.py.
SCREENER_DB_PATH=data/ndx_mom_buffer.db

# Optional: Slack/Discord incoming-webhook URL for alerts. Alerts are always
# written to data/ndx_mom_buffer/ALERTS.log and fail the systemd unit.
ALERT_WEBHOOK_URL=
